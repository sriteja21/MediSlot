{
  "info": {
    "_postman_id": "80e409ea-5ec0-4b19-a197-24910d3f658e",
    "name": "MediSlot API",
    "description": "Postman Collection v2.1 for the deployed MediSlot API. Set apiId and stage in collection variables. Public auth requests need no token; protected requests use accessToken. Use Registration options to get valid hospital and specialization IDs before registering a doctor. Booking is asynchronous: poll the booking request status endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://4o40pyo6n2.execute-api.ap-south-1.amazonaws.com/dev" },
    { "key": "stage", "value": "dev" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "patientEmail", "value": "patient@example.com" },
    { "key": "doctorEmail", "value": "doctor@example.com" },
    { "key": "password", "value": "ChangeThisPassword123!" },
    { "key": "doctorId", "value": "REPLACE_WITH_DOCTOR_ID" },
    { "key": "consultationTypeId", "value": "REPLACE_WITH_CONSULTATION_TYPE_ID" },
    { "key": "appointmentId", "value": "REPLACE_WITH_APPOINTMENT_ID" },
    { "key": "bookingRequestId", "value": "REPLACE_WITH_BOOKING_REQUEST_ID" },
    { "key": "offerId", "value": "REPLACE_WITH_WAITLIST_OFFER_ID" },
    { "key": "slotStart", "value": "2030-01-15T10:00:00Z" },
    { "key": "slotId", "value": "REPLACE_WITH_CONSULTATION_TYPE_ID#START_EPOCH_SECONDS" },
    { "key": "availabilityId", "value": "REPLACE_WITH_AVAILABILITY_ID" },
    { "key": "blackoutId", "value": "REPLACE_WITH_BLACKOUT_ID" },
    { "key": "consultationTypeRecordId", "value": "REPLACE_WITH_DOCTOR_CONSULTATION_TYPE_ID" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Registration options (hospital and specialization IDs)",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/{{stage}}/auth/registration-options"
          }
        },
        {
          "name": "Register patient",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"Sample Patient\",\n  \"date_of_birth\": \"1990-05-20\",\n  \"gender\": \"OTHER\",\n  \"phone\": \"+919876543210\",\n  \"emergency_contact_name\": \"Emergency Contact\",\n  \"emergency_contact_phone\": \"+919876543211\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/auth/patients/register"
          }
        },
        {
          "name": "Register doctor (replace IDs from Registration options)",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"Sample Doctor\",\n  \"licence_number\": \"LICENSE-REPLACE-ME\",\n  \"hospital_id\": \"REPLACE_WITH_HOSPITAL_UUID\",\n  \"specialisation_ids\": [1],\n  \"years_experience\": 5,\n  \"qualifications\": \"MBBS, MD\",\n  \"timezone\": \"Asia/Kolkata\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/auth/doctors/register"
          }
        },
        {
          "name": "Patient login (saves access and refresh tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.access_token) pm.collectionVariables.set('accessToken', data.access_token);",
                  "  if (data.refresh_token) pm.collectionVariables.set('refreshToken', data.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/auth/patients/login"
          }
        },
        {
          "name": "Doctor login (saves access and refresh tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.access_token) pm.collectionVariables.set('accessToken', data.access_token);",
                  "  if (data.refresh_token) pm.collectionVariables.set('refreshToken', data.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/auth/doctors/login"
          }
        },
        {
          "name": "Generic login",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/auth/login"
          }
        },
        {
          "name": "Refresh access token (saves new access token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.access_token) pm.collectionVariables.set('accessToken', data.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/{{stage}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Shared reads",
      "item": [
        {
          "name": "Get slots for a day",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/{{stage}}/slots?date=2030-01-15&doctor_id={{doctorId}}&consultation_type_id={{consultationTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{stage}}", "slots"],
              "query": [
                { "key": "date", "value": "2030-01-15" },
                { "key": "doctor_id", "value": "{{doctorId}}" },
                { "key": "consultation_type_id", "value": "{{consultationTypeId}}" }
              ]
            }
          }
        },
        {
          "name": "Get patient availability (date range)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/{{stage}}/slots?from=2030-01-15&to=2030-01-20&doctor_id={{doctorId}}&consultation_type_id={{consultationTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{stage}}", "slots"],
              "query": [
                { "key": "from", "value": "2030-01-15" },
                { "key": "to", "value": "2030-01-20" },
                { "key": "doctor_id", "value": "{{doctorId}}" },
                { "key": "consultation_type_id", "value": "{{consultationTypeId}}" }
              ]
            }
          }
        },
        {
          "name": "Get doctor consultation types",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{stage}}/doctors/me/consultation-types"
          }
        },
        {
          "name": "Get patient-facing doctor profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{stage}}/patients/doctors/{{doctorId}}"
          }
        }
      ]
    },
    {
      "name": "Doctor",
      "item": [
        {
          "name": "Get profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/doctors/me" }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\",\n  \"qualification\": \"MBBS, MD\",\n  \"experience_years\": 5,\n  \"timezone\": \"Asia/Kolkata\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/doctors/me"
          }
        },
        {
          "name": "Get profile photo upload URL",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/doctors/me/photo-upload-url" }
        },
        {
          "name": "Create consultation type",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"IN_PERSON\",\n  \"fee_amount\": 800,\n  \"capacity\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/doctors/me/consultation-types"
          }
        },
        {
          "name": "Update consultation type",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fee_amount\": 900,\n  \"is_active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/doctors/me/consultation-types/{{consultationTypeRecordId}}"
          }
        },
        {
          "name": "Delete consultation type",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/{{stage}}/doctors/me/consultation-types/{{consultationTypeRecordId}}"
          }
        },
        {
          "name": "Get availability patterns",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/doctors/me/availability" }
        },
        {
          "name": "Create availability pattern",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day_of_week\": 2,\n  \"start_local_time\": \"09:00\",\n  \"end_local_time\": \"12:00\",\n  \"consultation_type_id\": \"{{consultationTypeId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/doctors/me/availability"
          }
        },
        {
          "name": "Update availability pattern",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day_of_week\": 2,\n  \"start_local_time\": \"10:00\",\n  \"end_local_time\": \"13:00\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/doctors/me/availability/{{availabilityId}}"
          }
        },
        {
          "name": "Delete availability pattern",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/{{stage}}/doctors/me/availability/{{availabilityId}}" }
        },
        {
          "name": "Get blackouts",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/doctors/me/blackouts" }
        },
        {
          "name": "Create blackout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blackout_date\": \"2030-01-15\",\n  \"reason\": \"Personal leave\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/doctors/me/blackouts"
          }
        },
        {
          "name": "Delete blackout",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/{{stage}}/doctors/me/blackouts/{{blackoutId}}" }
        },
        {
          "name": "Doctor dashboard",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/doctors/me/dashboard" }
        },
        {
          "name": "Doctor payments",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/doctors/me/payments" }
        },
        {
          "name": "Doctor refunds",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/doctors/me/refunds" }
        },
        {
          "name": "Cancel appointment (doctor)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Doctor unavailable\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/doctors/me/appointments/{{appointmentId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Patient",
      "item": [
        {
          "name": "Get profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/patients/me" }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\",\n  \"gender\": \"OTHER\",\n  \"emergency_contact_name\": \"Emergency Contact\",\n  \"emergency_contact_phone\": \"+919876543211\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/patients/me"
          }
        },
        {
          "name": "Deactivate account",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/{{stage}}/patients/me" }
        },
        {
          "name": "Patient dashboard",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/patients/me/dashboard" }
        },
        {
          "name": "Search doctors",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/{{stage}}/patients/doctors/search?search=cardiology&specialization=&hospital=&city=",
              "host": ["{{baseUrl}}"],
              "path": ["{{stage}}", "patients", "doctors", "search"],
              "query": [
                { "key": "search", "value": "cardiology" },
                { "key": "specialization", "value": "", "disabled": true },
                { "key": "hospital", "value": "", "disabled": true },
                { "key": "city", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Doctor search filter options",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/patients/doctors/search-options" }
        },
        {
          "name": "Submit booking request",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultation_type_id\": \"{{consultationTypeId}}\",\n  \"appointment_datetime\": \"{{slotStart}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/patients/me/appointments"
          }
        },
        {
          "name": "Get booking request status",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/patients/me/booking-requests/{{bookingRequestId}}" }
        },
        {
          "name": "Cancel appointment (patient)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"No longer available\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/patients/me/appointments/{{appointmentId}}/cancel"
          }
        },
        {
          "name": "Preview cancellation refund",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/patients/me/appointments/{{appointmentId}}/refund-preview" }
        },
        {
          "name": "Get waitlists and offers",
          "request": { "method": "GET", "url": "{{baseUrl}}/{{stage}}/patients/me/waitlists" }
        },
        {
          "name": "Join waitlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_id\": \"{{slotId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/patients/me/waitlists"
          }
        },
        {
          "name": "Leave waitlist",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_id\": \"{{slotId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/{{stage}}/patients/me/waitlists"
          }
        },
        {
          "name": "Accept waitlist offer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/{{stage}}/patients/me/waitlist-offers/{{offerId}}/accept"
          }
        }
      ]
    }
  ]
}
